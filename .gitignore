# macOS
.DS_Store

# Xcode / SwiftPM — these never belong in git
xcuserdata/
*.xcuserstate
DerivedData/
build/
.build/
*.xcworkspace/xcuserdata/
.swiftpm/
# Xcode generates this on first open; it holds only local state.
*.xcodeproj/project.xcworkspace/

# Pinned SwiftLint and SwiftFormat binaries, fetched by `just tools`. Versions are pinned
# in the Justfile and in CI; the binaries themselves are a local cache.
.tools/

# Secrets. This repo is public: no credentials, team ids, or provisioning
# profiles are ever committed. See CLAUDE.md.
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
.env
.env.*
Secrets.xcconfig
